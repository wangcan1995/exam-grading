# ===== 生产环境配置 =====
# 复制为 .env.prod 并填入实际值:  cp .env.prod.example .env.prod

APP_NAME=试卷阅卷打分系统
APP_ENV=prod
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

# 数据库: SQLite 存到持久化卷
DATABASE_URL=sqlite:////app/data/exam_grading.db

# 存储 (容器内路径，映射到 docker volume)
STORAGE_DIR=/app/storage
UPLOAD_DIR=/app/storage/uploads
PROCESSED_DIR=/app/storage/processed

# OMR 配置
OMR_FILL_THRESHOLD=0.50
ANSWER_SHEET_WIDTH=1240
ANSWER_SHEET_HEIGHT=1754

# ===== 对象存储 (可选，留空则用本地存储) =====
# 配置后图片上传到 COS，减轻服务器磁盘压力
# 腾讯云 COS: https://console.cloud.tencent.com/cos
STORAGE_TYPE=local              # local 或 cos
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou         # 如 ap-beijing / ap-shanghai
COS_BUCKET=                     # 如 exam-grading-1250000000

# ===== LLM (第2期，暂留空) =====
LLM_API_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
