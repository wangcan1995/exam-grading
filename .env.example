# ===== 应用配置 =====
APP_NAME=试卷阅卷打分系统
APP_ENV=dev                          # dev / prod
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# ===== 数据库 (MVP 用 SQLite，零配置) =====
# 切换 PostgreSQL: postgresql+psycopg2://user:pass@localhost:5432/exam_grading
DATABASE_URL=sqlite:///./exam_grading.db

# ===== 存储路径 =====
STORAGE_DIR=./storage
UPLOAD_DIR=./storage/uploads
PROCESSED_DIR=./storage/processed

# ===== AI 配置 (MVP 仅启用图像处理) =====
# OMR 涂卡检测阈值: 圆圈内黑像素占比超过此值判定为"已涂"
OMR_FILL_THRESHOLD=0.50
# 透视矫正后答题卡目标尺寸 (宽, 高)
ANSWER_SHEET_WIDTH=1240
ANSWER_SHEET_HEIGHT=1754               # A4 @ 150dpi

# ===== 第 2 期预留 =====
# LLM_API_PROVIDER=deepseek
# LLM_API_KEY=
# LLM_MODEL=deepseek-chat
